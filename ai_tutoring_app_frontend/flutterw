#!/usr/bin/env bash
# PUBLIC_INTERFACE
# Flutter wrapper that runs flutter commands from the correct app directory.
# Usage examples:
#   ./flutterw pub get
#   ./flutterw analyze
#   ./flutterw test
#   ./flutterw run
set -euo pipefail

# Determine repo root and app directory.
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$SCRIPT_DIR"
# Check standard markers in priority order.
if [[ -f "$REPO_ROOT/FLUTTER_APP_DIR" ]]; then
  APP_DIR_REL="$(tail -n 1 "$REPO_ROOT/FLUTTER_APP_DIR")"
elif [[ -f "$REPO_ROOT/ai-tutoring-platform-5516-5525/FLUTTER_PROJECT_PATH.txt" ]]; then
  APP_DIR_REL="ai-tutoring-platform-5516-5525/$(tail -n 1 "$REPO_ROOT/ai-tutoring-platform-5516-5525/FLUTTER_PROJECT_PATH.txt")"
else
  # Fallback to known path in this workspace.
  APP_DIR_REL="ai-tutoring-platform-5516-5525/ai_tutoring_app_frontend"
fi

APP_DIR="$REPO_ROOT/$APP_DIR_REL"

if [[ ! -d "$APP_DIR" ]]; then
  echo "Error: Flutter app directory not found at: $APP_DIR" >&2
  exit 1
fi

cd "$APP_DIR"
exec flutter "$@"
